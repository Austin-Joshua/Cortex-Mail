# ─── Backend API ──────────────────────────────────────────────────────────
# Development: http://localhost:8080
# Production: https://your-backend-url.onrender.com (NO trailing slash, NO /api)
VITE_API_BASE_URL=http://localhost:8080

# NOTE: there is deliberately no VITE_GOOGLE_CLIENT_ID here.
# The browser used to build the Google consent URL itself, which meant the
# client id had to be duplicated into the frontend. When it was unset — which
# it was in every deployment — the sign-in button sent users to Google with an
# empty client_id and Google answered "Error 400: invalid_request".
# The backend now builds that URL and redirects, so the client id is only ever
# configured once, in the backend's GOOGLE_CLIENT_ID.
