# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Required for real "Sign in with Google". Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID,
# type "Web application") and add this exact authorised redirect URI:
#     http://localhost:8080/api/auth/google/callback
# The client id is configured here ONLY — the frontend no longer needs it.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT: must be at least 32 characters long
JWT_SECRET=your-minimum-32-character-jwt-secret-key-here
# Encryption: must be exactly 16 characters
ENCRYPTION_KEY=your16charenckey

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── AI ───────────────────────────────────────────────────────────────────────
# Gemini powers classification, summaries, action-item extraction and Brain
# Q&A. Get a key from https://aistudio.google.com
# Without it the app still runs, but falls back to keyword matching.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Defaults to gemini-flash-latest, a rolling alias.
# Do NOT pin a dated model here unless you intend to maintain it: when a
# pinned version is retired the API returns 404 and the app silently falls
# back to keyword classification. Check available models with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-flash-latest

# ─── Local development shortcut ───────────────────────────────────────────────
# Opens GET /api/auth/bypass, which mints a signed-in session against a seeded
# demo account without going through Google — useful for clicking through the
# UI before you have OAuth credentials.
# The seeded demo account carries PRE-WRITTEN summaries, not AI output: real
# Gmail sync is skipped for it. To see Gemini actually classify your mail you
# must sign in with a real Google account.
# Never set this true on a deployed instance; it hands out sessions to anyone.
DEV_BYPASS_ENABLED=false

# ─── Database (optional — defaults to H2 in-memory if not set) ───────────────
# H2 is in-memory: everything resets on restart. Use MySQL to persist.
# DB_URL=jdbc:mysql://localhost:3306/nexora_db
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── H2 Console (Development only — disable in production!) ─────────────────
H2_CONSOLE_ENABLED=false
