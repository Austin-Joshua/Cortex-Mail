# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT: must be at least 32 characters long
JWT_SECRET=your-minimum-32-character-jwt-secret-key-here
# Encryption: must be exactly 16 characters
ENCRYPTION_KEY=your16charenckey

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── AI (optional — keyword fallback works without a key) ────────────────────
# Get Gemini key from: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Defaults to gemini-flash-latest, a rolling alias.
# Do NOT pin a dated model here unless you intend to maintain it: when a
# pinned version is retired the API returns 404 and the app silently falls
# back to keyword classification. Check available models with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-flash-latest

# ─── Database ────────────────────────────────────────────────────────────────
# Default (no vars / no prod profile): H2 in-memory — data wiped on restart.
#
# Supabase Postgres (recommended for deploy and persistent local):
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-db-password
#
# These names must match application-prod.yml and render.yaml (DB_URL, not DATABASE_URL).
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=org.postgresql.Driver

# ─── Optional production ─────────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=8080
