# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT: must be at least 32 characters long
JWT_SECRET=your-minimum-32-character-jwt-secret-key-here
# Encryption: must be exactly 16 characters
ENCRYPTION_KEY=your16charenckey

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── AI (Claude recommended, Gemini fallback if not set) ─────────────────────
# Get Claude key from: https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# Get Gemini key from: https://aistudio.google.com
# Only used if CLAUDE_API_KEY is not set (auto-fallback)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Defaults to gemini-flash-latest, a rolling alias.
# Do NOT pin a dated model here unless you intend to maintain it: when a
# pinned version is retired the API returns 404 and the app silently falls
# back to keyword classification. Check available models with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#        https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL=gemini-flash-latest

# ─── Database ────────────────────────────────────────────────────────────────
# Default (no vars): H2 in-memory — data wiped on restart.
#
# Supabase Postgres (recommended for deploy):
# Dashboard → Connect → Session pooler (IPv4) or Direct (IPv6).
# Convert URI to JDBC and set sslmode=require.
#
# DB_URL=jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=your_supabase_db_password
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# H2_CONSOLE_ENABLED=false
#
# MySQL alternative:
# DB_URL=jdbc:mysql://localhost:3306/nexora_db
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── H2 Console (Development only — disable in production!) ─────────────────
H2_CONSOLE_ENABLED=false
